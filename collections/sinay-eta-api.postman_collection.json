      "name": "ETA",
      "description": {
        "content": "Estimated time of arrival prediction for a vessel to a destination port.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "fc9eec50-967b-4043-8759-a4fd053df48d",
          "name": "ETA computation for a vessel to a destination port.",
          "request": {
            "name": "ETA computation for a vessel to a destination port.",
            "description": {
              "content": "Predicts a vessel's estimated time of arrival. Identify the vessel by IMO (or MMSI). With only a vessel and an arrival port, the API selects the latest AIS-transmitted position as the departure point; alternatively supply a departure port and date. Arrival is a port UN/LOCODE. `vessel` and `arrival` are required.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "etac",
                "api",
                "v1",
                "compute-eta"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vessel\": {\n    \"imo\": \"<long>\",\n    \"mmsi\": \"<long>\",\n    \"speed\": \"<double>\"\n  },\n  \"arrival\": {\n    \"portCode\": \"<string>\"\n  },\n  \"departure\": {\n    \"date\": \"<dateTime>\",\n    \"portCode\": \"<string>\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
