          "id": "992b60c1-884e-4964-9c73-18a0fe66e7e0",
          "name": "Retrieve CO2 consumption for a trip from one port to another.",
          "request": {
            "name": "Retrieve CO2 consumption for a trip from one port to another.",
            "description": {
              "content": "Computes the CO2 emissions of a TEU for a voyage between two ports. Identify the vessel by IMO or MMSI (not both). Departure and arrival are ports identified by 5-character UN/LOCODE. Returns voyage length in nautical miles and tons of CO2 per TEU for a vessel-model method (Tank-to-Wheel) and a GLEC Framework tradelane method (Well-to-Tank, Tank-to-Wheel, Well-to-Wheel).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "co2",
                "api",
                "v2",
                "compute-co2"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
